@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent

<root>
    @if (Manager?.MatchOver == true)
    {
        <div style="position: absolute; width: 100%; height: 100%; background-color: rgba(0,0,0,0.7); display: flex; align-items: center; justify-content: center; flex-direction: column;">
            <div style="color: #ffcc33; font-size: 60px; margin-bottom: 20px;">MATCH OVER</div>
            <div style="color: white; font-size: 30px; margin-bottom: 40px;">@Manager?.WinnerName wins!</div>
            <div style="color: yellow; font-size: 28px; cursor: pointer;" onclick="@Restart">Press E to Restart</div>
        </div>
    }
</root>

@code
{
    ArenaGameManager Manager => Scene.GetAllComponents<ArenaGameManager>().FirstOrDefault();

    protected override void OnUpdate()
    {
        if (Manager?.MatchOver == true && Input.Pressed("use"))
        {
            Restart();
        }

        StateHasChanged();
    }

    void Restart()
    {
        Scene.Load(Scene.Source);
    }
}
