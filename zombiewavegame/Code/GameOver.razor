@using Sandbox;
@using Sandbox.UI;
@inherits PanelComponent

<root>
    @if (IsGameOver)
    {
        <div style="position: absolute; width: 100%; height: 100%; background-color: rgba(0,0,0,0.7); display: flex; align-items: center; justify-content: center; flex-direction: column;">
            <div style="color: red; font-size: 60px; margin-bottom: 20px;">GAME OVER</div>
            <div style="color: white; font-size: 30px; margin-bottom: 10px;">You survived until Round @Round</div>
            <div style="color: white; font-size: 24px; margin-bottom: 40px;">Level reached: @Level</div>
            <div style="color: yellow; font-size: 28px; cursor: pointer;" onclick="@RestartGame">Press E to Restart</div>
        </div>
    }
</root>

@code
{
    public bool IsGameOver { get; set; } = false;
    public int Round { get; set; } = 1;
    public int Level { get; set; } = 1;

    protected override void OnUpdate()
    {
        if (IsGameOver && Input.Pressed("use"))
        {
            RestartGame();
        }

        StateHasChanged();
    }

    public void ShowGameOver(int round, int level)
    {
        IsGameOver = true;
        Round = round;
        Level = level;
        StateHasChanged();
    }

    void RestartGame()
    {
        Scene.Load(Scene.Source);
    }
}
